{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "test/**", "*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        "noVoid": "error",
        "noCommaOperator": "error"
      },
      "style": {
        "useBlockStatements": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["../*/**", "../../**", "!../../drizzle/*.sql", "#*/**"],
                "message": "Import other modules as #<module> (its index.ts; see imports in package.json), e.g. #store; their other files are internal, and a relative path may not leave its module."
              }
            ]
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExplicitType": "error",
        "useExhaustiveSwitchCases": "error"
      },
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "src/testing/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          },
          "nursery": {
            "useExplicitType": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/store/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "bun:sqlite": "The database is the store module's business: use src/store/index.ts.",
                  "drizzle-orm": "The database is the store module's business: use src/store/index.ts."
                },
                "patterns": [
                  {
                    "group": ["../*/**", "../../**", "!../../drizzle/*.sql", "#*/**"],
                    "message": "Import other modules as #<module> (its index.ts; see imports in package.json), e.g. #store; their other files are internal, and a relative path may not leave its module."
                  },
                  {
                    "group": ["drizzle-orm/*"],
                    "message": "The database is the store module's business: use src/store/index.ts."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
