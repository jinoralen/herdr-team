{
  "name": "herdr-agent-hub",
  "version": "0.1.0",
  "description": "Chat rooms for coding agents running in Herdr panes",
  "type": "module",
  "private": true,
  "imports": {
    "#agent": "./src/agent/index.ts",
    "#herdr": "./src/herdr/index.ts",
    "#rooms": "./src/rooms/index.ts",
    "#store": "./src/store/index.ts",
    "#testing": "./src/testing/index.ts"
  },
  "scripts": {
    "build": "bun build --compile --minify src/cli/main.ts --outfile dist/herdr-agent-hub",
    "dev": "bun src/cli/main.ts",
    "typecheck": "bun check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "knip": "knip",
    "verify": "biome check . && bun check && knip && bun test",
    "prepare": "lefthook install",
    "db:generate": "rm -rf drizzle && drizzle-kit generate --name init"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest",
    "drizzle-kit": "0.31.11",
    "knip": "6.41.0",
    "lefthook": "2.2.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@commander-js/extra-typings": "15.0.0",
    "commander": "15.0.0",
    "drizzle-orm": "0.45.4",
    "zod": "^4.6.5"
  }
}
